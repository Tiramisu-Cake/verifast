+pub unsafe fn shared_cleanup<T>(t: T, b: bool)
+//@ req thread_token(?tid) &*& tid == currentThread;
+//@ ens thread_token(tid);
+//@ on_unwind_ens thread_token(tid);
+{
+    let _ = std::mem::ManuallyDrop::new(t);
+    new(b);
+}
